"""
snakemake -n
snakemake -c 7 --use-conda --use-singularity --singularity-args "--bind $CDATA"
"""

base_name = "variants.argaz.mscaf_a1_01"

configfile: "workflow/config.yml"
# read in container ids
c_zooroh = config[ 'sif_zooroh' ]

# --- target rule ---
rule all:
    input: 
      cMgeno = "../results/genotypes/{nm}_cM.gen.gz".format( nm = base_name ),
      roh = "../results/zooroh/roh_segments.tsv.gz",
      f_tab = "../results/zooroh/inbreeding_by_HBD_class.tsv",
      loacl_hbd = "../results/zooroh/local_hbd_prop",
      pdf = "../results/summary.pdf"

# --- worker rules ---
# for sample names
rule idx_vcf:
    input:
      vcf = "../data/{nm}.vcf.gz".format( nm = base_name )
    output:
      idx = "../data/{nm}.vcf.gz.tbi".format( nm = base_name )
    conda: "popgen_basics"
    shell:
      """
      tabix -p vcf {input.vcf}
      """ 

# extract sample names
rule vcf_sample_names:
    input:
      vcf = "../data/{nm}.vcf.gz".format( nm = base_name ),
      idx = "../data/{nm}.vcf.gz.tbi".format( nm = base_name )
    output:
      smpl = "../results/{nm}.samples".format( nm = base_name )
    conda: "popgen_basics"
    shell:
      """
      vcfsamplenames {input.vcf} > {output.smpl}
      """ 

# genotype conversion
rule convert_vcf_to_geno:
    input:
      vcf = "../data/{nm}.vcf.gz".format( nm = base_name )
    output:
      geno = "../results/genotypes/{nm}.gen.gz".format( nm = base_name ),
      tmp = temp( "../results/genotypes/{nm}_init.gen.gz".format( nm = base_name ) )
    conda: "popgen_basics"
    params:
      prefix = "../results/genotypes/{nm}".format( nm = base_name )
    shell:
      """
      bcftools convert \
        -g {params.prefix} \
        --3N6 \
        --tag GT \
        {input.vcf} 
        
      mv {params.prefix}.gen.gz {output.tmp}
    
      zcat {params.prefix}_init.gen.gz | \
        sed -e 's/ 0.33/ 0/g' | \
        gzip > {output.geno}
      """

rule tsv_genetic_map:
    input:
      tsv = "../data/normalized_genetic_map.mscaf_a1_01.tsv.gz"
    output:
      gmap = "../results/genetic_map_norm.bed.gz"
    conda: "popgen_basics"
    shell:
      """
      zcat {input.tsv} | \
        cut -f 1-4,10 | \
        awk -v OFS='\t' '{{if(NR>1){{print $0}} }}' | \
        bgzip > {output.gmap}
      """

rule convert_bp_to_cM_positions:
    input:
      geno = "../results/genotypes/{nm}.gen.gz".format( nm = base_name ),
      gmap = "../results/genetic_map_norm.bed.gz"
    output:
      geno = "../results/genotypes/{nm}_cM.gen.gz".format( nm = base_name )
    conda: "py3"
    threads: 7
    shell:
      """
      py/bp2cm -i {input.geno} -m {input.gmap} -t {threads} -o {output.geno}
      """

# running zooroh with provided R script
rule run_zooroh:
    input:
      geno = "../results/genotypes/{nm}_cM.gen.gz".format( nm = base_name ),
      smpl = "../results/{nm}.samples".format( nm = base_name )
    output:
      roh = "../results/zooroh/roh_segments.tsv.gz",
      f_tab = "../results/zooroh/inbreeding_by_HBD_class.tsv",
      local_hbd = directory( "../results/zooroh/local_hbd_prop" )
    params:
      base_dir = "results/zooroh",
      gt_fmt = "gp",
      rate_type = "cM"
    threads: 7
    container: c_zooroh
    shell:
      """
      Rscript --vanilla R/run_zooroh.R \
        {input.geno} \
        {input.smpl} \
        {params.base_dir} \
        {output.roh} \
        {output.f_tab} \
        {params.gt_fmt} \
        {params.rate_type} \
        {threads} \
        {output.local_hbd}
      """

# plotting the zooroh results
rule plot_zooroh_summary:
    input:
      roh = "../results/zooroh/roh_segments.tsv.gz",
      f_tab = "../results/zooroh/inbreeding_by_HBD_class.tsv",
      local_hbd = "../results/zooroh/local_hbd_prop"
    output:
      pdf = "../results/summary.pdf"
    params:
      focal_sample = "AGF00014"
    conda: "r_tidy"
    shell:
      """
      Rscript --vanilla R/plot_tidy.R {params.focal_sample}
      """